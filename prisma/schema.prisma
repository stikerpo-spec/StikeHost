datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  servers      Server[]
}

model Server {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  name        String
  slug        String   @unique
  version     String   @default("1.21.8")
  type        String   @default("VANILLA")
  ramMb       Int      @default(2048)
  port        Int
  status      String   @default("stopped")
  motd        String   @default("A Minecraft Server")
  maxPlayers  Int      @default(20)
  gamemode    String   @default("survival")
  difficulty  String   @default("normal")
  hardcore    Boolean  @default(false)
  pvp         Boolean  @default(true)
  onlineMode  Boolean  @default(true)
  whitelist   Boolean  @default(false)
  commandAliases Json?
  createdAt   DateTime @default(now())
  worlds      World[]
}

model World {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields:[serverId], references:[id], onDelete:Cascade)
  name       String
  seed       String?
  gamemode   String   @default("survival")
  difficulty String   @default("normal")
  levelType  String   @default("minecraft:normal")
  createdAt  DateTime @default(now())
  @@unique([serverId, name])
}
